# Copy to apps/api/.env when launching the API from apps/api.
AI_PROVIDER=mock
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/muse-glimmer-30b
NVIDIA_TIMEOUT_SECONDS=45
NVIDIA_MAX_TOKENS=4096
NVIDIA_REASONING_EFFORT=low
MAX_VIDEO_BYTES=104857600
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_SECONDS=120
# Evidence gates are policy thresholds, not calibrated success probabilities.
VERIFICATION_MIN_CONFIDENCE=0.75
VERIFICATION_DIGITAL_QUALITY=0.4
VERIFICATION_PHYSICAL_QUALITY=0.65
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
