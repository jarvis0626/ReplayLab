{
  "name": "ReplayLab curated observation verification scenarios v1",
  "scene_defaults": {
    "visibility": 1.0, "coverage": 1.0, "image_quality": 1.0,
    "comparable": true, "provider_mode": "mock", "observations": [],
    "provenance": {"source": "curated-observation-fixture", "detection_complete": true}
  },
  "scenarios": [
    {"id":"present","title":"Required block is reliably visible","expected":"pass","rules":[{"id":"r","kind":"presence","subject":"red"}],"observations":[{"label":"red","bbox":[0.2,0.2,0.4,0.4],"confidence":0.99}]},
    {"id":"missing","title":"Missing required block in completely observed scene","expected":"fail","rules":[{"id":"r","kind":"presence","subject":"red"}],"observations":[]},
    {"id":"low-confidence","title":"Low confidence detection cannot prove absence","expected":"uncertain","rules":[{"id":"r","kind":"presence","subject":"red"}],"observations":[{"label":"red","bbox":[0.2,0.2,0.4,0.4],"confidence":0.3}]},
    {"id":"unknown-confidence","title":"Unknown confidence remains unknown","expected":"uncertain","rules":[{"id":"r","kind":"presence","subject":"red"}],"observations":[{"label":"red","bbox":[0.2,0.2,0.4,0.4]}]},
    {"id":"above","title":"Red center is clearly above blue","expected":"pass","rules":[{"id":"r","kind":"above","subject":"red","target":"blue"}],"observations":[{"label":"red","bbox":[0.2,0.1,0.4,0.3],"confidence":0.99},{"label":"blue","bbox":[0.2,0.6,0.4,0.8],"confidence":0.99}]},
    {"id":"above-reversed","title":"Red is visibly below its required position","expected":"fail","rules":[{"id":"r","kind":"above","subject":"red","target":"blue"}],"observations":[{"label":"red","bbox":[0.2,0.6,0.4,0.8],"confidence":0.99},{"label":"blue","bbox":[0.2,0.1,0.4,0.3],"confidence":0.99}]},
    {"id":"above-boundary","title":"Centers overlap within the uncertainty margin","expected":"uncertain","rules":[{"id":"r","kind":"above","subject":"red","target":"blue"}],"observations":[{"label":"red","bbox":[0.2,0.2,0.4,0.4],"confidence":0.99},{"label":"blue","bbox":[0.5,0.21,0.7,0.41],"confidence":0.99}]},
    {"id":"below","title":"Red center is clearly below blue","expected":"pass","rules":[{"id":"r","kind":"below","subject":"red","target":"blue"}],"observations":[{"label":"red","bbox":[0.2,0.6,0.4,0.8],"confidence":0.99},{"label":"blue","bbox":[0.2,0.1,0.4,0.3],"confidence":0.99}]},
    {"id":"left","title":"Red center is clearly left of blue","expected":"pass","rules":[{"id":"r","kind":"left","subject":"red","target":"blue"}],"observations":[{"label":"red","bbox":[0.1,0.2,0.3,0.4],"confidence":0.99},{"label":"blue","bbox":[0.6,0.2,0.8,0.4],"confidence":0.99}]},
    {"id":"right","title":"Red center is clearly right of blue","expected":"pass","rules":[{"id":"r","kind":"right","subject":"red","target":"blue"}],"observations":[{"label":"red","bbox":[0.6,0.2,0.8,0.4],"confidence":0.99},{"label":"blue","bbox":[0.1,0.2,0.3,0.4],"confidence":0.99}]},
    {"id":"near","title":"Object centers satisfy approved proximity","expected":"pass","rules":[{"id":"r","kind":"near","subject":"red","target":"blue","value":0.3}],"observations":[{"label":"red","bbox":[0.2,0.2,0.3,0.3],"confidence":0.99},{"label":"blue","bbox":[0.35,0.2,0.45,0.3],"confidence":0.99}]},
    {"id":"too-far","title":"Object separation visibly exceeds proximity limit","expected":"fail","rules":[{"id":"r","kind":"near","subject":"red","target":"blue","value":0.2}],"observations":[{"label":"red","bbox":[0.1,0.2,0.2,0.3],"confidence":0.99},{"label":"blue","bbox":[0.7,0.2,0.8,0.3],"confidence":0.99}]},
    {"id":"aligned","title":"Centers align horizontally on x axis","expected":"pass","rules":[{"id":"r","kind":"aligned","subject":"red","target":"blue","value":"x"}],"observations":[{"label":"red","bbox":[0.2,0.1,0.4,0.3],"confidence":0.99},{"label":"blue","bbox":[0.21,0.6,0.41,0.8],"confidence":0.99}]},
    {"id":"misaligned","title":"Centers visibly violate approved alignment","expected":"fail","rules":[{"id":"r","kind":"aligned","subject":"red","target":"blue","value":"x"}],"observations":[{"label":"red","bbox":[0.1,0.1,0.3,0.3],"confidence":0.99},{"label":"blue","bbox":[0.6,0.6,0.8,0.8],"confidence":0.99}]},
    {"id":"color","title":"Independent reliable color evidence matches","expected":"pass","rules":[{"id":"r","kind":"color","subject":"block","value":"red"}],"observations":[{"label":"block","bbox":[0.2,0.2,0.4,0.4],"confidence":0.99,"color":"red","color_confidence":0.99}]},
    {"id":"wrong-color","title":"Independent reliable color evidence disagrees","expected":"fail","rules":[{"id":"r","kind":"color","subject":"block","value":"red"}],"observations":[{"label":"block","bbox":[0.2,0.2,0.4,0.4],"confidence":0.99,"color":"blue","color_confidence":0.99}]},
    {"id":"unknown-color","title":"Label alone cannot establish object color","expected":"uncertain","rules":[{"id":"r","kind":"color","subject":"red","value":"red"}],"observations":[{"label":"red","bbox":[0.2,0.2,0.4,0.4],"confidence":0.99}]},
    {"id":"count","title":"Complete reliable scene supports exact count","expected":"pass","rules":[{"id":"r","kind":"count","subject":"red","value":2}],"observations":[{"label":"red","bbox":[0.1,0.2,0.3,0.4],"confidence":0.99},{"label":"red","bbox":[0.6,0.2,0.8,0.4],"confidence":0.99}]},
    {"id":"extra-block","title":"Visible extra block proves count mismatch","expected":"fail","rules":[{"id":"r","kind":"count","subject":"red","value":1}],"observations":[{"label":"red","bbox":[0.1,0.2,0.3,0.4],"confidence":0.99},{"label":"red","bbox":[0.6,0.2,0.8,0.4],"confidence":0.99}]},
    {"id":"incomplete-count","title":"Partial scene cannot establish exact count","expected":"uncertain","scene":{"coverage":0.7,"provenance":{"detection_complete":false}},"rules":[{"id":"r","kind":"count","subject":"red","value":2}],"observations":[{"label":"red","bbox":[0.1,0.2,0.3,0.4],"confidence":0.99}]},
    {"id":"occlusion","title":"Occluded scene needs another checkpoint","expected":"uncertain","scene":{"visibility":0.4},"rules":[{"id":"r","kind":"presence","subject":"red"}],"observations":[{"label":"red","bbox":[0.2,0.2,0.4,0.4],"confidence":0.99}]},
    {"id":"poor-image","title":"Poor image quality cannot support a verdict","expected":"uncertain","scene":{"image_quality":0.2},"rules":[{"id":"r","kind":"presence","subject":"red"}],"observations":[{"label":"red","bbox":[0.2,0.2,0.4,0.4],"confidence":0.99}]},
    {"id":"camera-mismatch","title":"Incomparable camera geometry remains uncertain","expected":"uncertain","scene":{"comparable":false},"rules":[{"id":"r","kind":"presence","subject":"red"}],"observations":[{"label":"red","bbox":[0.2,0.2,0.4,0.4],"confidence":0.99}]},
    {"id":"missing-in-partial-scene","title":"Absent detection without completeness is uncertain","expected":"uncertain","scene":{"coverage":null,"provenance":{"detection_complete":false}},"rules":[{"id":"r","kind":"presence","subject":"red"}],"observations":[]},
    {"id":"visible-in-partial-scene","title":"Reliable visible object does not need absence coverage","expected":"pass","scene":{"coverage":null,"provenance":{"detection_complete":false}},"rules":[{"id":"r","kind":"presence","subject":"red"}],"observations":[{"label":"red","bbox":[0.2,0.2,0.4,0.4],"confidence":0.99}]}
  ]
}
